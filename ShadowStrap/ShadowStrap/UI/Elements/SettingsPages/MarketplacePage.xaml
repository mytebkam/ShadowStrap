<ui:UiPage x:Class="ShadowStrap.UI.Elements.SettingsPages.MarketplacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ShadowStrap Marketplace">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TextBox PlaceholderText="Search for themes, icons, or emote wheels..." Icon="Search24" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1">
            <ui:ItemsControl>
                <!-- Example Item -->
                <ui:Card Margin="0,0,0,10" Padding="15">
                    <DockPanel>
                        <Image Source="/Resources/ThemePreview.png" Width="60" Height="60" Margin="0,0,15,0" DockPanel.Dock="Left"/>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="Anime Emote Wheel" FontTypography="Subtitle" FontWeight="Bold"/>
                            <ui:TextBlock Text="by User123 • 1.2k Downloads" Foreground="#272d3c"/>
                        </StackPanel>
                        <ui:Button Content="Install" Appearance="Primary" HorizontalAlignment="Right" Background="#0e1018"/>
                    </DockPanel>
                </ui:Card>
            </ui:ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:UiPage>