<ui:UiPage x:Class="ShadowStrap.UI.Elements.SettingsPages.VpnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ShadowStrap VPN">
    <StackPanel Margin="20">
        <ui:CardControl Header="VPN Configuration" Icon="Shield24">
            <StackPanel>
                <ui:TextBox PlaceholderText="Enter API Key for Subscription" Margin="0,10,0,0" />
                <ui:Button Content="Connect to ShadowStrap VPN" Appearance="Primary" Margin="0,10,0,0" Background="#0e1018"/>
            </StackPanel>
        </ui:CardControl>
        
        <ui:CardControl Header="Custom Config" Margin="0,20,0,0">
            <ui:Button Content="Upload sing-box config (JSON)" />
        </ui:CardControl>

        <ui:TextBlock Text="Server Latency: -- ms" Margin="0,20,0,0" Foreground="#272d3c" />
    </StackPanel>
</ui:UiPage>